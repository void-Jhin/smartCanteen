DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.vercel.app,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com
CANTEEN_ADMIN_PASSWORD=replace-admin-pin
CANTEEN_STAFF_PASSWORD=replace-staff-password
TIME_ZONE=Asia/Manila
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
